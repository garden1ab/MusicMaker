# Copy to `.env` and adjust. All values are optional; defaults shown.

# ---- Server ----
PORT=8000
MAX_DURATION=240            # safety cap on track length (seconds)

# ---- Model ----
# 3.5B v1 fits comfortably in 16 GB VRAM. For the higher-quality XL (4B) model,
# set ACE_MODEL accordingly and turn on CPU offload to stay within 16 GB.
ACE_MODEL=ACE-Step/ACE-Step-v1-3.5B
ACE_DTYPE=bfloat16          # bfloat16 (fast) | float32
ACE_DEVICE_ID=0

# Optional: a Lyric2Vocal LoRA (HF repo id or local path) for generating pure
# vocal stems from lyrics. Leave empty — the base model already sings lyrics.
# ACE_VOCAL_LORA=

# ---- Memory / speed tuning ----
# Turn CPU offload ON if you hit out-of-memory (trades speed for VRAM; can run
# in ~8 GB). overlapped_decode speeds up decoding. torch_compile is left OFF
# because JIT PTX compilation is currently flaky on Blackwell (sm_120).
ACE_CPU_OFFLOAD=false
ACE_OVERLAPPED_DECODE=true
ACE_TORCH_COMPILE=false

# ---- Dev ----
# DEMO_MODE=1 runs the full UI with a placeholder tone generator and NO GPU /
# model download. Great for trying the interface on a laptop.
DEMO_MODE=0

# Pin a specific Blackwell-ready base image tag (>=2.7.0, cuda12.8):
# PYTORCH_TAG=2.10.0-cuda12.8-cudnn9-devel
